# Copy to .env and fill in real values. Never commit .env.
FT_ENV=dev                         # dev | prod
FT_DB_HOST=127.0.0.1
FT_DB_PORT=3306
FT_DB_NAME=foodticket
FT_DB_USER=foodticket
FT_DB_PASS=change-me
FT_SMTP_HOST=smtp.gmail.com
FT_SMTP_PORT=465
FT_SMTP_USER=you@example.com
FT_SMTP_PASS=your-gmail-app-password
FT_SMTP_FROM="FoodTicket <you@example.com>"
FT_BASE_URL=http://localhost:8080  # public URL used in emails
